# ==================================================
# App
# ==================================================
APP_ENV=development
LOG_LEVEL=INFO

# ==================================================
# MySQL
# ==================================================
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=supportops
MYSQL_USER=supportops_user
MYSQL_PASSWORD=supportops_password

# ==================================================
# Internal API
# ==================================================
INTERNAL_API_BASE_URL=http://localhost:8001

# ==================================================
# MCP Server
# ==================================================
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# ==================================================
# Simulated user context
# 1 = support_agent
# 2 = support_manager
# 3 = admin
# ==================================================
CURRENT_USER_ID=1

# ==================================================
# LLM Provider
# Currently supported: ollama
# ==================================================
LLM_PROVIDER=ollama

# ==================================================
# Ollama
# OLLAMA_MODE options: local, cloud
# ==================================================
OLLAMA_MODE=local

# Local Ollama
OL_LOCAL_BASE_URL=http://localhost:11434
OL_LOCAL_MODEL=qwen2.5:7b

# Ollama Cloud
OL_CLOUD_BASE_URL=https://ollama.com
OL_CLOUD_MODEL=qwen3.5:397b-cloud
OL_API_KEY=